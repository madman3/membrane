# Local development defaults. Copy to .env and change the password outside this machine.
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_NS=memeval
SURREAL_DB=memeval
SURREAL_USER=root
SURREAL_PASS=root

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

ANTHROPIC_API_KEY=
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Results are not comparable across models.
EVAL_MODEL=claude-haiku-5-5

# Eon connector. {connector} is replaced with the connector name.
EON_CLIENT_ID=
EON_CLIENT_SECRET=
EON_TOKEN_ENDPOINT=
EON_BASE_TEMPLATE=https://{connector}-mcp.era.eon.io
# Optional control-plane provenance; snapshot dayState is null when unset.
EON_DAY_STATE=
